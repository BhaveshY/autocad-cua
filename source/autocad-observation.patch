+unsafe fn walk_provider_bounded(
+    element: &IUIAutomationElement,
+    cache_req: &IUIAutomationCacheRequest,
+    walker: &windows::Win32::UI::Accessibility::IUIAutomationTreeWalker,
+    depth: usize,
+    parent_index: Option<usize>,
+    in_web_content: bool,
+    nodes: &mut Vec<UiaNode>,
+    lines: &mut Vec<(usize, String)>,
+    counter: &mut usize,
+    total: &mut usize,
+    max_elements: usize,
+    max_depth: usize,
+) {
+    if depth > max_depth || *total >= max_elements {
+        return;
+    }
+    let cached = match element.BuildUpdatedCache(cache_req) {
+        Ok(cached) => cached,
+        Err(error) => {
+            // Charge failed nodes to the same budget; do not retry indefinitely.
+            *total += 1;
+            lines.push((depth, format!("- <UIA node unavailable: {error}>")));
+            return;
+        }
+    };
+    let before = nodes.len();
+    let web_child =
+        in_web_content || read_cached_control_type(&cached).eq_ignore_ascii_case("Document");
+    // Element-only cache has no children. Reuse the established node renderer
+    // and retained action handles without a second representation.
+    walk_cached_bounded(
+        &cached,
+        depth,
+        parent_index,
+        in_web_content,
+        nodes,
+        lines,
+        counter,
+        total,
+        max_elements,
+        depth,
+    );
+    let emitted_parent = if nodes.len() > before {
+        nodes
+            .last()
+            .and_then(|node| node.element_index)
+            .or(parent_index)
+    } else {
+        parent_index
+    };
+    if depth >= max_depth || *total >= max_elements {
+        return;
+    }
+    let mut next = walker.GetFirstChildElement(element).ok();
+    while let Some(child) = next {
+        walk_provider_bounded(
+            &child,
+            cache_req,
+            walker,
+            depth + 1,
+            emitted_parent,
+            web_child,
+            nodes,
+            lines,
+            counter,
+            total,
+            max_elements,
+            max_depth,
+        );
+        if *total >= max_elements {
+            break;
+        }
+        next = walker.GetNextSiblingElement(&child).ok();
+    }
